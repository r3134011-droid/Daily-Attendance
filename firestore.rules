rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidDateKey(dateStr) {
      return dateStr is string &&
             dateStr.size() == 10 &&
             dateStr.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidPayrollSettings(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.startDay is int &&
             data.startDay >= 1 &&
             data.startDay <= 31 &&
             data.salary is number &&
             data.salary >= 0 &&
             data.salary <= 100000000 &&
             data.otRate is number &&
             data.otRate >= 0 &&
             data.otRate <= 1000000 &&
             data.pf is number &&
             data.pf >= 0 &&
             data.pf <= 10000000 &&
             data.esi is number &&
             data.esi >= 0 &&
             data.esi <= 10000000 &&
             data.advance is number &&
             data.advance >= 0 &&
             data.advance <= 10000000;
    }

    function isValidAttendanceRecord(data) {
      return data.userId is string &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             isValidDateKey(data.date) &&
             data.status is string &&
             data.status.size() <= 2 &&
             data.status in ['', 'P', 'A', 'H', 'W'] &&
             data.otHours is number &&
             data.otHours >= 0 &&
             data.otHours <= 24;
    }

    match /users/{userId}/payroll/{settingId} {
      allow get: if isSignedIn() &&
                    request.auth.uid == userId &&
                    settingId == 'settings';

      allow list: if isSignedIn() &&
                     request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       settingId == 'settings' &&
                       isValidPayrollSettings(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'startDay', 'salary', 'otRate', 'pf', 'esi', 'advance', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'startDay', 'salary', 'otRate', 'pf', 'esi', 'advance', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time;

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       settingId == 'settings' &&
                       isValidPayrollSettings(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'startDay', 'salary', 'otRate', 'pf', 'esi', 'advance', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() &&
                       request.auth.uid == userId &&
                       settingId == 'settings';
    }

    match /users/{userId}/attendance/{dateKey} {
      allow get: if isSignedIn() &&
                    request.auth.uid == userId &&
                    isValidDateKey(dateKey);

      allow list: if isSignedIn() &&
                     request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidDateKey(dateKey) &&
                       isValidAttendanceRecord(incoming()) &&
                       incoming().userId == request.auth.uid &&
                       incoming().date == dateKey &&
                       incoming().keys().hasAll([
                         'userId', 'date', 'status', 'otHours', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'date', 'status', 'otHours', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time;

      allow update: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidDateKey(dateKey) &&
                       isValidAttendanceRecord(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().date == existing().date &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'status', 'otHours', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidDateKey(dateKey);
    }
  }
}
